<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- bibmd in the browser: the reader's own sources (../src, without the Wayland Program.cs)
       in a .NET WebAssembly app on Bibui.Platform.Browser, drawn by the managed rasterizer
       on a <canvas>. Needs the wasm-tools workload; web/build.sh publishes it to web/dist. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bibmd-web</AssemblyName>
    <RootNamespace>BibMd</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup>
    <BibDocRoot Condition="'$(BibDocRoot)' == ''">$(MSBuildThisFileDirectory)../../bibdoc</BibDocRoot>
    <!-- bibui as bibmd builds it (the integration checkout); its browser platform is not released yet. -->
    <BibuiSource Condition="'$(BibuiSource)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../bibui-bib-agent'))</BibuiSource>
    <BibuiBrowserNativeDir>$(BibuiSource)/bibui-platform-browser/native/lib/</BibuiBrowserNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/**/*.cs" Exclude="../src/Program.cs" />
    <EmbeddedResource Include="../assets/fonts/*.ttf" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(BibDocRoot)/src/BibDoc/BibDoc.csproj" />
    <ProjectReference Include="$(BibuiSource)/bibui-core/bibui-core.csproj" />
    <ProjectReference Include="$(BibuiSource)/bibui-platform-browser/bibui-platform-browser.csproj" />
    <ProjectReference Include="$(BibuiSource)/bibui-raster-managed/backend/Bibui.Raster.Managed.Backend.csproj" />
  </ItemGroup>
  <Import Project="$(BibuiSource)/bibui-platform-browser/buildTransitive/Bibui.Platform.Browser.targets" />
</Project>
