<Project Sdk="Microsoft.NET.Sdk">
  <!-- The check of md FILE.bib.md, headless: bibdoc and bibmd's text-only sources (no bibui). In this folder: dotnet run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <BibDocRoot Condition="'$(BibDocRoot)' == ''">$(MSBuildThisFileDirectory)../../../bibdoc</BibDocRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BibDocRoot)/src/BibDoc/BibDoc.csproj" />
    <Compile Include="../../src/Blocks.cs;../../src/Fences.cs;../../src/Check.cs" Link="Bibmd/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
